{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // MODELO POR DEFECTO
  // ============================================================

  "model": "opencode/mimo-v2.5-free",

  // ============================================================
  // COMPACTACIÓN
  // ============================================================

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  // ============================================================
  // AGENTE REVIEWER
  // ============================================================

  "agent": {
    "reviewer": {
      "description": "Revisor de código de solo lectura para GestorDeCobrosIA",

      "mode": "subagent",

      "model": "opencode/mimo-v2.5-free",

      "prompt": "{file:./.opencode/agents/reviewer.md}",

      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny"
      }
    }
  }
}