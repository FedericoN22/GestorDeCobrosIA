@page "/"
@inject KioskApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@implements IDisposable

@if (!Auth.IsAuthenticated)
{
    Nav.NavigateTo("/login");
    return;
}

<h1 class="mb-3">Productos</h1>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/productos/crear">+ Nuevo producto</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<Toast @ref="_toast" />

@if (_cargando)
{
    <p>Cargando…</p>
}
else if (_productos.Count == 0)
{
    <div class="alert alert-info">Todavía no hay productos.</div>
}
else
{
    @foreach (var producto in _productos)
    {
        <div class="card mb-4 shadow-sm border">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@producto.Nombre</strong>
                <span class="text-muted">@NombreCategoria(producto.CategoriaId)</span>
                <button class="btn btn-sm btn-danger ms-2" @onclick="() => IniciarEliminarProducto(producto.Id)">Eliminar</button>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">@producto.Presentaciones.Count presentación(es)</span>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAgregarPresentacion(producto.Id)">
                        + Agregar presentación
                    </button>
                </div>

                @if (_presentacionesAgregando.Contains(producto.Id))
                {
                    <div class="border rounded p-3 mb-3 bg-surface">
                        <h6>Nueva presentación</h6>
                        <div class="mb-2">
                            <label class="form-label">Nombre *</label>
                            <input class="form-control form-control-sm" @bind="_nuevaPresentacionNombre" placeholder="Ej: 500ml, Caja x12" />
                        </div>
                        <div class="row mb-2">
                            <div class="col">
                                <label class="form-label">Precio venta ($) *</label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_nuevaPresentacionPrecio" />
                            </div>
                            <div class="col">
                                <label class="form-label">Precio costo ($)</label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_nuevaPresentacionCosto" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col">
                                <label class="form-label">Código de barras</label>
                                <input class="form-control form-control-sm" @bind="_nuevaPresentacionCodigoBarras" />
                            </div>
                            <div class="col">
                                <label class="form-label">Stock mínimo</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="_nuevaPresentacionStockMinimo" />
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-primary" @onclick="() => AgregarPresentacion(producto.Id)">Guardar</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelarAgregarPresentacion(producto.Id)">Cancelar</button>
                        </div>
                        @if (_agregarPresentacionError is not null)
                        {
                            <div class="text-danger small mt-2">@_agregarPresentacionError</div>
                        }
                    </div>
                }

                @if (producto.Presentaciones.Count == 0)
                {
                    <p class="text-muted mb-0">Sin presentaciones.</p>
                }
                else
                {
                    <div class="presentaciones-section">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Presentación</th>
                                    <th>Código</th>
                                    <th class="text-end">Precio venta</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Stock mín.</th>
                                    <th>Estado</th>
                                    <th style="min-width: 200px;">Añadir stock</th>
                                    <th style="min-width: 180px;">Acciones</th>
                                </tr>
                            </thead>
                        <tbody>
                            @foreach (var presentacion in producto.Presentaciones)
                            {
                                <tr>
                                    <td>@presentacion.Nombre</td>
                                    <td class="text-muted">@(presentacion.CodigoBarras ?? "—")</td>
                                    <td class="text-end">@Moneda.Formatear(presentacion.PrecioVentaCentavos)</td>
                                    <td class="text-end">@presentacion.StockActual</td>
                                    <td class="text-end">@(presentacion.StockMinimo.HasValue ? presentacion.StockMinimo.Value.ToString() : "—")</td>
                                    <td>
                                        @if (presentacion.StockMinimo.HasValue && presentacion.StockActual <= presentacion.StockMinimo.Value)
                                        {
                                            <span class="badge bg-danger">Stock bajo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">OK</span>
                                        }
                                    </td>
                                    <td>
                                        <EntradaStock PresentacionId="@presentacion.Id" OnCargada="CargarProductos" />
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" @onclick="() => ToggleEditarPresentacion(presentacion.Id, producto.Id)" title="Editar">Editar</button>
                                            <button class="btn btn-outline-danger" @onclick="() => IniciarEliminarPresentacion(presentacion.Id, producto.Id)" title="Eliminar">Eliminar</button>
                                        </div>
                                    </td>
                                </tr>

                                @if (_presentacionEditando == presentacion.Id)
                                {
                                    <tr>
                                        <td colspan="9">
                                            <div class="border rounded p-3 bg-surface">
                                                <h6>Editar presentación</h6>
                                                <div class="mb-2">
                                                    <label class="form-label">Nombre *</label>
                                                    <input class="form-control form-control-sm" @bind="_editarPresentacionNombre" />
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col">
                                                        <label class="form-label">Precio venta ($) *</label>
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_editarPresentacionPrecio" />
                                                    </div>
                                                    <div class="col">
                                                        <label class="form-label">Precio costo ($)</label>
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="_editarPresentacionCosto" />
                                                    </div>
                                                </div>
                                                <div class="row mb-2">
                                                    <div class="col">
                                                        <label class="form-label">Código de barras</label>
                                                        <input class="form-control form-control-sm" @bind="_editarPresentacionCodigoBarras" />
                                                    </div>
                                                    <div class="col">
                                                        <label class="form-label">Stock mínimo</label>
                                                        <input type="number" min="0" class="form-control form-control-sm" @bind="_editarPresentacionStockMinimo" />
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-primary" @onclick="() => GuardarEditarPresentacion(presentacion.Id, producto.Id)">Guardar</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelarEditarPresentacion()">Cancelar</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<ProductoResponse> _productos = new();
    private Dictionary<Guid, string> _categorias = new();
    private bool _cargando = true;
    private string? _error;
    private Toast? _toast;
    private readonly Dictionary<Guid, CancellationTokenSource> _eliminacionesPendientes = new();
    private readonly object _locker = new();

    private HashSet<Guid> _presentacionesAgregando = new();
    private string _nuevaPresentacionNombre = "";
    private decimal _nuevaPresentacionPrecio;
    private decimal _nuevaPresentacionCosto;
    private string _nuevaPresentacionCodigoBarras = "";
    private int _nuevaPresentacionStockMinimo;
    private string? _agregarPresentacionError;

    private Guid? _presentacionEditando;
    private Guid? _editarPresentacionProductoId;
    private string _editarPresentacionNombre = "";
    private decimal _editarPresentacionPrecio;
    private decimal _editarPresentacionCosto;
    private string _editarPresentacionCodigoBarras = "";
    private int _editarPresentacionStockMinimo;

    private async Task ToggleAgregarPresentacion(Guid productoId)
    {
        if (_presentacionesAgregando.Contains(productoId))
        {
            _presentacionesAgregando.Remove(productoId);
            LimpiarFormularioNuevaPresentacion();
        }
        else
        {
            _presentacionesAgregando.Add(productoId);
            _agregarPresentacionError = null;
        }
    }

    private void LimpiarFormularioNuevaPresentacion()
    {
        _nuevaPresentacionNombre = "";
        _nuevaPresentacionPrecio = 0;
        _nuevaPresentacionCosto = 0;
        _nuevaPresentacionCodigoBarras = "";
        _nuevaPresentacionStockMinimo = 0;
        _agregarPresentacionError = null;
    }

    private async Task AgregarPresentacion(Guid productoId)
    {
        _agregarPresentacionError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_nuevaPresentacionNombre))
            {
                _agregarPresentacionError = "El nombre de la presentación es obligatorio.";
                return;
            }
            await Api.AgregarPresentacionAsync(
                productoId,
                new AgregarPresentacionRequest(
                    _nuevaPresentacionNombre.Trim(),
                    Moneda.Acentavos(_nuevaPresentacionPrecio),
                    _nuevaPresentacionCosto is { } costo ? Moneda.Acentavos(costo) : null,
                    string.IsNullOrWhiteSpace(_nuevaPresentacionCodigoBarras) ? null : _nuevaPresentacionCodigoBarras.Trim(),
                    _nuevaPresentacionStockMinimo == 0 ? null : _nuevaPresentacionStockMinimo),
                CancellationToken.None);
            _presentacionesAgregando.Remove(productoId);
            LimpiarFormularioNuevaPresentacion();
            await CargarProductos();
        }
        catch (ApiException ex)
        {
            _agregarPresentacionError = ex.Message;
        }
    }

    private void CancelarAgregarPresentacion(Guid productoId)
    {
        _presentacionesAgregando.Remove(productoId);
        LimpiarFormularioNuevaPresentacion();
    }

    private void ToggleEditarPresentacion(Guid presentacionId, Guid productoId)
    {
        if (_presentacionEditando == presentacionId)
        {
            _presentacionEditando = null;
            _editarPresentacionProductoId = null;
        }
        else
        {
            _presentacionEditando = presentacionId;
            _editarPresentacionProductoId = productoId;
            var producto = _productos.FirstOrDefault(p => p.Id == productoId);
            var presentacion = producto?.Presentaciones.FirstOrDefault(p => p.Id == presentacionId);
            if (presentacion is not null)
            {
                _editarPresentacionNombre = presentacion.Nombre;
                _editarPresentacionPrecio = Moneda.DeCentavos(presentacion.PrecioVentaCentavos);
                _editarPresentacionCosto = presentacion.PrecioCostoCentavos.HasValue ? Moneda.DeCentavos(presentacion.PrecioCostoCentavos.Value) : 0;
                _editarPresentacionCodigoBarras = presentacion.CodigoBarras ?? "";
                _editarPresentacionStockMinimo = presentacion.StockMinimo ?? 0;
            }
        }
    }

    private void CancelarEditarPresentacion()
    {
        _presentacionEditando = null;
        _editarPresentacionProductoId = null;
    }

    private async Task GuardarEditarPresentacion(Guid presentacionId, Guid productoId)
    {
        try
        {
            await Api.EditarPresentacionAsync(
                presentacionId,
                new EditarPresentacionRequest(
                    _editarPresentacionNombre.Trim(),
                    Moneda.Acentavos(_editarPresentacionPrecio),
                    _editarPresentacionCosto is { } costo ? Moneda.Acentavos(costo) : null,
                    string.IsNullOrWhiteSpace(_editarPresentacionCodigoBarras) ? null : _editarPresentacionCodigoBarras.Trim(),
                    _editarPresentacionStockMinimo == 0 ? null : _editarPresentacionStockMinimo),
                CancellationToken.None);
            _presentacionEditando = null;
            _editarPresentacionProductoId = null;
            await CargarProductos();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void IniciarEliminarPresentacion(Guid presentacionId, Guid productoId)
    {
        var producto = _productos.FirstOrDefault(p => p.Id == productoId);
        var presentacion = producto?.Presentaciones.FirstOrDefault(p => p.Id == presentacionId);
        if (producto is null || presentacion is null) return;

        var cts = new CancellationTokenSource();
        lock (_locker)
        {
            _eliminacionesPendientes[presentacionId] = cts;
        }

        _toast?.Mostrar(
            $"Presentación '{presentacion.Nombre}' eliminada",
            "#061E29",
            puedeDeshacer: true,
            onDeshacer: () =>
            {
                lock (_locker)
                {
                    _eliminacionesPendientes.Remove(presentacionId);
                }
                cts.Cancel();
                cts.Dispose();
            },
            duracionMs: 5000,
            mostrarContador: true);

        _ = EjecutarEliminacionPresentacionAsync(presentacionId, cts.Token);
    }

    private async Task EjecutarEliminacionPresentacionAsync(Guid presentacionId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(5000, cancellationToken);

            lock (_locker)
            {
                _eliminacionesPendientes.Remove(presentacionId);
            }

            _error = null;
            try
            {
                await Api.EliminarPresentacionAsync(presentacionId, cancellationToken);
                await CargarProductos();
                StateHasChanged();
            }
            catch (ApiException ex)
            {
                _error = $"Error al eliminar la presentación: {ex.Message}";
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void IniciarEliminarProducto(Guid productoId)
    {
        var producto = _productos.FirstOrDefault(p => p.Id == productoId);
        if (producto is null) return;

        var cts = new CancellationTokenSource();
        lock (_locker)
        {
            _eliminacionesPendientes[productoId] = cts;
        }

        _toast?.Mostrar(
            $"Producto '{producto.Nombre}' eliminado",
            "#dc3545",
            puedeDeshacer: true,
            onDeshacer: () =>
            {
                lock (_locker)
                {
                    _eliminacionesPendientes.Remove(productoId);
                }
                cts.Cancel();
                cts.Dispose();
            },
            duracionMs: 5000,
            mostrarContador: true);

        _ = EjecutarEliminarProductoAsync(productoId, cts.Token);
    }

    private async Task EjecutarEliminarProductoAsync(Guid productoId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(5000, cancellationToken);

            lock (_locker)
            {
                _eliminacionesPendientes.Remove(productoId);
            }

            _error = null;
            try
            {
                await Api.EliminarProductoAsync(productoId, cancellationToken);
                await CargarProductos();
                StateHasChanged();
            }
            catch (ApiException ex)
            {
                _error = $"Error al eliminar el producto: {ex.Message}";
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            return;
        }
        await CargarProductos();
    }

    private string NombreCategoria(Guid? categoriaId)
        => categoriaId is { } id && _categorias.TryGetValue(id, out var nombre) ? nombre : "Sin categoría";

    private async Task CargarProductos()
    {
        _cargando = true;
        _error = null;
        try
        {
            var productos = await Api.GetProductosAsync(CancellationToken.None);
            var categorias = await Api.GetCategoriasAsync(CancellationToken.None);
            _productos = productos.ToList();
            _categorias = categorias.ToDictionary(c => c.Id, c => c.Nombre);
        }
        catch (ApiException ex)
        {
            if (ex.EsAutenticacion)
            {
                await Auth.LimpiarAsync();
                Nav.NavigateTo("/login");
            }
            else
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    public void Dispose()
    {
        lock (_locker)
        {
            foreach (var cts in _eliminacionesPendientes.Values)
            {
                cts.Cancel();
                cts.Dispose();
            }
            _eliminacionesPendientes.Clear();
        }
    }
}
