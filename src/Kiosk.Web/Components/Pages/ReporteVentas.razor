@page "/reportes/ventas"
@inject KioskApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!Auth.IsAuthenticated)
{
    Nav.NavigateTo("/login");
    return;
}

<h1 class="mb-3">Ventas por período</h1>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" class="form-control" @bind="_desde" />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" class="form-control" @bind="_hasta" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <button class="btn btn-primary" @onclick="Cargar" disabled="@_cargando">Consultar</button>
    </div>
    <div class="col-auto d-flex align-items-end">
        <button class="btn btn-outline-secondary" @onclick="ExportarCsv" disabled="@_cargando">Exportar CSV</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_reporte is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Total vendido</div>
                    <div class="fs-4">@Moneda.Formatear(_reporte.TotalVendidoCentavos)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Cantidad de ventas</div>
                    <div class="fs-4">@_reporte.CantidadVentas</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Ticket promedio</div>
                    <div class="fs-4">@Moneda.Formatear(_reporte.TicketPromedioCentavos)</div>
                </div>
            </div>
        </div>
    </div>

    <h5>Por día</h5>
    @if (_reporte.PorDia.Count == 0)
    {
        <p class="text-muted">Sin ventas en el período.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in _reporte.PorDia)
                {
                    <tr>
                        <td>@fila.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@fila.Cantidad</td>
                        <td class="text-end">@Moneda.Formatear(fila.TotalCentavos)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5>Por medio de pago</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Medio</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in _reporte.PorMedioPago)
            {
                <tr>
                    <td>@Etiquetas.Medio(fila.Medio)</td>
                    <td class="text-end">@fila.Cantidad</td>
                    <td class="text-end">@Moneda.Formatear(fila.MontoCentavos)</td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Por cajero</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Cajero</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in _reporte.PorCajero)
            {
                <tr>
                    <td>@fila.CajeroNombre</td>
                    <td class="text-end">@fila.Cantidad</td>
                    <td class="text-end">@Moneda.Formatear(fila.TotalCentavos)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DateTime _desde = DateTime.Today;
    private DateTime _hasta = DateTime.Today;
    private ReporteVentasResponse? _reporte;
    private bool _cargando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsAuthenticated)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        try
        {
            _reporte = await Api.GetReporteVentasAsync(_desde, _hasta, CancellationToken.None);
        }
        catch (ApiException ex)
        {
            TratarError(ex);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task ExportarCsv()
    {
        var url = Api.UrlCsv($"api/reportes/ventas.csv?desde={_desde:yyyy-MM-dd}&hasta={_hasta:yyyy-MM-dd}");
        await JS.InvokeVoidAsync("descargarCsv", url, Auth.Token, "ventas-por-periodo");
    }

    private void TratarError(ApiException ex)
    {
        if (ex.EsAutenticacion)
        {
            Auth.Limpiar();
            Nav.NavigateTo("/login");
        }
        else
        {
            _error = ex.Message;
        }
    }
}
