@page "/productos/crear"
@inject KioskApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

@if (!Auth.IsAuthenticated)
{
    Nav.NavigateTo("/login");
    return;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="mb-3">Nuevo producto</h1>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <form @onsubmit="Guardar" @onsubmit:preventDefault="true">
            <div class="mb-3">
                <label class="form-label">Nombre *</label>
                <input class="form-control" @bind="_nombre" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoría</label>
                <select class="form-select" @bind="_categoriaId">
                    <option value="">Sin categoría</option>
                    @foreach (var categoria in _categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
            </div>

            <hr />

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="conPresentacion" @bind="_conPresentacion" />
                <label class="form-check-label" for="conPresentacion">Crear la primera presentación</label>
            </div>

            @if (_conPresentacion)
            {
                <div class="mb-3">
                    <label class="form-label">Nombre de la presentación *</label>
                    <input class="form-control" @bind="_presentacionNombre" required />
                </div>
                <div class="row">
                    <div class="col mb-3">
                        <label class="form-label">Precio de venta ($) *</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="_precioVenta" required />
                    </div>
                    <div class="col mb-3">
                        <label class="form-label">Precio de costo ($)</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="_precioCosto" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Código de barras</label>
                    <input class="form-control" @bind="_codigoBarras" />
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_cargando">
                    @(_cargando ? "Guardando…" : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" href="/">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@code {
    private List<CategoriaResponse> _categorias = new();
    private string _nombre = "";
    private Guid? _categoriaId;
    private bool _conPresentacion;
    private string _presentacionNombre = "";
    private decimal _precioVenta;
    private decimal? _precioCosto;
    private string _codigoBarras = "";
    private bool _cargando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            return;
        }

        try
        {
            _categorias = (await Api.GetCategoriasAsync(CancellationToken.None)).ToList();
        }
        catch (ApiException ex)
        {
            if (ex.EsAutenticacion)
            {
                Auth.Limpiar();
                Nav.NavigateTo("/login");
            }
            else
            {
                _error = ex.Message;
            }
        }
    }

    private async Task Guardar()
    {
        _cargando = true;
        _error = null;
        try
        {
            var creado = await Api.CrearProductoAsync(_nombre.Trim(), _categoriaId, CancellationToken.None);

            if (_conPresentacion && !string.IsNullOrWhiteSpace(_presentacionNombre))
            {
                await Api.AgregarPresentacionAsync(
                    creado.ProductoId,
                    new AgregarPresentacionRequest(
                        _presentacionNombre.Trim(),
                        Moneda.Acentavos(_precioVenta),
                        _precioCosto is { } costo ? Moneda.Acentavos(costo) : null,
                        string.IsNullOrWhiteSpace(_codigoBarras) ? null : _codigoBarras.Trim()),
                    CancellationToken.None);
            }

            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            if (ex.EsAutenticacion)
            {
                Auth.Limpiar();
                Nav.NavigateTo("/login");
            }
            else
            {
                _error = ex.Message;
            }
        }
        finally
        {
            _cargando = false;
        }
    }
}
