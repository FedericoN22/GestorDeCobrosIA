                Inicio
            </NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-heading">OPERACIÓN</div>

            <NavLink class="nav-link" href="productos/crear" @onclick="OnNavClick">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0z"/></svg>
                Productos
            </NavLink>

            <NavLink class="nav-link" href="" @onclick="OnNavClick">
