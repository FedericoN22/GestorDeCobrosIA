                <NavLink class="nav-link" href="reportes/movimientos" @onclick="OnNavClick">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1 2.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2zm0 8a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2zM5 4a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 4zm0 8a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 12zm5-4a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5v-2z"/></svg>
                    Movimientos de stock
                </NavLink>
            }

            @if (Auth.TienePermiso("ganancias.ver"))
            {
                <NavLink class="nav-link" href="reportes/ganancias" @onclick="OnNavClick">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M4 10.781c.148 1.661 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718H4zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.878c.273.322.57.616.918.867V12h-1.54v-.867c.34-.25.644-.544.917-.867z"/></svg>
                    Ganancias
                </NavLink>

                <NavLink class="nav-link" href="reportes/ranking" @onclick="OnNavClick">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5c0 .538-.012 1.05-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 3.29-3.06 4.3H5.95c-1.182-1.01-2.27-2.435-3.06-4.297A3 3 0 1 1 1.765 2.034C1.744 1.538 1.732 1.024 1.732.5zM3 14a1 1 0 1 0 2 0 1 1 0 0 0-2 0zm10-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
                    Ranking
                </NavLink>
            }

            @if (Auth.TienePermiso("auditoria.ver"))
            {
                <NavLink class="nav-link" href="reportes/auditoria" @onclick="OnNavClick">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.55.55 0 0 0 .1 0 .529.529 0 0 0 .027-.007c.076-.024.174-.061.293-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.553.29-.801.477a7.158 7.158 0 0 1-.8.457c-.048.025-.09.048-.122.064a.55.55 0 0 1-.064.025.548.548 0 0 1-.057-.013 7.16 7.16 0 0 1-.8-.457 7.158 7.158 0 0 1-1.048-.625 11.776 11.776 0 0 1-2.517-2.453C1.928 10.611.545 7.294 1.141 2.817A1.54 1.54 0 0 1 2.185 1.555c.658-.215 1.776-.57 2.887-.87z"/></svg>
                    Auditoría
                </NavLink>
            }
        </div>

        @if (Auth.TienePermiso("whatsapp.operar"))
        {
            <div class="nav-section">
                <div class="nav-heading">CANALES</div>

                <NavLink class="nav-link" href="whatsapp/whitelist" @onclick="OnNavClick">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/></svg>
                    WhatsApp
                </NavLink>
            </div>
        }

        <div class="nav-section">
            <div class="nav-heading">ADMINISTRACIÓN</div>

            <NavLink class="nav-link" href="chat" @onclick="OnNavClick">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M14 1a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4.414A2 2 0 0 0 3 11.586l-2 2V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12.793a.5.5 0 0 0 .854.353l2.853-2.853A1 1 0 0 1 4.414 12H14a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/></svg>
                Chat
            </NavLink>

            <NavLink class="nav-link" href="whatsapp/config" @onclick="OnNavClick">
                <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.421 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.421-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/></svg>
                Configuración
            </NavLink>
        </div>
    }
</nav>

<div class="sidebar-footer">
    @if (Auth.IsAuthenticated && Auth.Usuario is not null)
    {
        <div class="user-info">
            <div class="user-avatar">
                @GetInitials(Auth.Usuario.Nombre)
            </div>
            <div class="user-details">
                <span class="user-name">@Auth.Usuario.Nombre</span>
                <span class="user-role">@Auth.Usuario.Rol</span>
            </div>
        </div>
        <button class="logout-btn" @onclick="CerrarSesion">
            <svg class="nav-icon" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0v2z"/><path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3z"/></svg>
            Cerrar sesión
        </button>
    }
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChange;
    }

    private void OnAuthChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnNavClick()
    {
        await OnNavigate.InvokeAsync();
    }

    private async Task CerrarSesion()
    {
        await Auth.LimpiarAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private string GetInitials(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var parts = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return (parts[0][0..1] + parts[^1][0..1]).ToUpperInvariant();
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChange;
    }
}
