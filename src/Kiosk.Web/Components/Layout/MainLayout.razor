@inherits LayoutComponentBase
@inject AuthState Auth
@inject NavigationManager Nav

@implements IDisposable

@{
    var isLoginPage = new Uri(Nav.Uri).AbsolutePath.TrimStart('/') == "login";
}

<div class="page@(isLoginPage ? " page-login" : "")">
    @if (Auth.IsAuthenticated && !isLoginPage)
    {
        <div class="sidebar-overlay @(_sidebarOpen ? "open" : "")" @onclick="CloseSidebar"></div>
        <aside class="sidebar @(_sidebarOpen ? "open" : "")">
            <NavMenu OnNavigate="CloseSidebar" />
        </aside>
    }

    <div class="main-area">
        @if (Auth.IsAuthenticated && !isLoginPage)
        {
            <header class="mobile-header">
                <button class="hamburger" @onclick="ToggleSidebar" aria-label="Abrir menú">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
                <span class="mobile-brand">GESTOR DE COBROS IA</span>
            </header>
        }

        <main class="content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Un error no controlado ocurrió.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarOpen;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        Auth.OnChange += OnAuthChange;
    }

    private void OnAuthChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChange;
    }
}
