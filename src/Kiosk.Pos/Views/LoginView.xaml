<UserControl x:Class="Kiosk.Pos.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Border Width="360" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#F4F6F8" CornerRadius="10" BorderBrush="#D9DEE3" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Kiosk POS" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1F3B57" />
                <TextBlock Text="Ingresá con tu usuario de cajero" FontSize="12" Margin="0,4,0,20" HorizontalAlignment="Center" Foreground="#667085" />

                <TextBlock Text="Usuario" Foreground="#344054" />
                <TextBox x:Name="TxtUsuario" Height="34" Margin="0,4,0,14" Padding="6,4" VerticalContentAlignment="Center" FontSize="15" />

                <TextBlock Text="Contraseña" Foreground="#344054" />
                <PasswordBox x:Name="TxtPassword" Height="34" Margin="0,4,0,20" Padding="6,4" VerticalContentAlignment="Center" FontSize="15" KeyDown="TxtPassword_KeyDown" />

                <Button x:Name="BtnIngresar" Content="Ingresar" Height="40" FontSize="15" FontWeight="Bold"
                        Background="#1F6FB2" Foreground="White" BorderThickness="0" Click="BtnIngresar_Click" />
                <Button x:Name="BtnIngresarOffline" Content="Ingresar sin conexión" Height="34" Margin="0,10,0,0"
                        FontSize="12" Background="#EEF2F6" Foreground="#344054" BorderThickness="0"
                        Visibility="Collapsed" Click="BtnIngresarOffline_Click" />

                <TextBlock x:Name="TxtError" Foreground="#B42318" FontSize="13" Margin="0,14,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
