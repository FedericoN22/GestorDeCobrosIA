<UserControl x:Class="Kiosk.Pos.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F4F7">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Barra superior ===== -->
        <Border Grid.Row="0" Background="#1F3B57" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotConexion" Width="12" Height="12" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock x:Name="LblConexion" Text="Online" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="#9CA3AF" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblPendientes" Text="Cola: 0" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="#9CA3AF" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblUltimaSync" Text="Última sync: -" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="LblUsuario" Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnCambiarUsuario" Content="Cambiar usuario" Margin="0,0,8,0" Padding="10,4"
                            Background="#2E5A80" Foreground="White" BorderThickness="0" Click="BtnCambiarUsuario_Click" />
                    <Button Content="Salir" Padding="10,4" Background="#B42318" Foreground="White" BorderThickness="0"
                            Click="BtnSalir_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Barra de caja ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,8,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Caja: " Foreground="#344054" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblCaja" Text="Cerrada" Foreground="#344054" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblCajaDetalle" Foreground="#667085" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Fondo inicial ($):" Foreground="#344054" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="TxtMontoInicial" Width="90" Height="28" Padding="4,2" VerticalContentAlignment="Center" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnAbrirCaja" Content="Abrir caja" Padding="14,6" Background="#1F6FB2"
                            Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAbrirCaja_Click" />
                    <Button x:Name="BtnCerrarCaja" Content="Cerrar caja (arqueo)" Padding="14,6" Background="#B54708"
                            Foreground="White" BorderThickness="0" FontWeight="Bold" Visibility="Collapsed"
                            Click="BtnCerrarCaja_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Mensajes ===== -->
        <TextBlock x:Name="TxtMensaje" Grid.Row="2" Foreground="#B42318" FontSize="13" Margin="4,8,4,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <!-- ===== Área principal ===== -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Columna: búsqueda -->
            <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Buscar producto" FontWeight="Bold" Foreground="#344054" FontSize="14" />
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBusqueda" Height="32" Padding="6,3" FontSize="14" VerticalContentAlignment="Center"
                                 KeyDown="TxtBusqueda_KeyDown" />
                        <Button Grid.Column="1" Content="Buscar" Margin="6,0,0,0" Padding="12,0" Background="#1F6FB2"
                                Foreground="White" BorderThickness="0" Click="BtnBuscar_Click" />
                    </Grid>

                    <ListBox x:Name="ListResultados" Grid.Row="2" BorderThickness="0" Background="#F9FAFB"
                             MouseDoubleClick="ListResultados_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ProductoNombre}" FontWeight="Bold" Foreground="#1F3B57" />
                                            <TextBlock Text=" - " Foreground="#9CA3AF" />
                                            <TextBlock Text="{Binding PresentacionNombre}" Foreground="#344054" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding PrecioVentaCentavos, Converter={StaticResource CentavosARSPrecio}}" Foreground="#1F6FB2" FontWeight="Bold" />
                                            <TextBlock Text="  ·  Stock: " Foreground="#9CA3AF" />
                                            <TextBlock Text="{Binding StockActual}" Foreground="{Binding StockActual, Converter={StaticResource StockBajoARSC}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#344054" />
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cant." VerticalAlignment="Center" Foreground="#344054" Margin="0,0,6,0" />
                        <TextBox x:Name="TxtCantidad" Height="30" Padding="4,2" VerticalContentAlignment="Center" Text="1" FontSize="14" />
                        <Button Grid.Column="2" x:Name="BtnAgregar" Content="Agregar al carrito" Margin="6,0,0,0" Padding="10,0"
                                Background="#22A06B" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                Click="BtnAgregar_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Columna: carrito -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Carrito de venta" FontWeight="Bold" Foreground="#344054" FontSize="14" />
                        <Button Grid.Column="1" Content="Vaciar" Padding="10,2" Background="#EEF2F6" Foreground="#344054"
                                BorderThickness="0" Click="BtnVaciar_Click" />
                    </Grid>

                    <DataGrid x:Name="GridCarrito" Grid.Row="1" Margin="0,8,0,8" IsReadOnly="True" AutoGenerateColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False"
                              Background="White" BorderBrush="#E4E7EC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*" />
                            <DataGridTextColumn Header="Presentación" Binding="{Binding PresentacionNombre}" Width="*" />
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitarioCentavos, Converter={StaticResource CentavosARSPrecio}}" Width="80" />
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalCentavos, Converter={StaticResource CentavosARSPrecio}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-1" Padding="10,4" Margin="0,0,6,0" Background="#EEF2F6" BorderThickness="0" Click="BtnRestar_Click" />
                            <Button Content="+1" Padding="10,4" Margin="0,0,6,0" Background="#EEF2F6" BorderThickness="0" Click="BtnSumar_Click" />
                            <Button Content="Quitar" Padding="10,4" Background="#FEF3F2" Foreground="#B42318" BorderThickness="0" Click="BtnQuitar_Click" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="LblTotal" FontSize="22" FontWeight="Bold" Foreground="#1F3B57" Text="$0,00" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Columna: cobro -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cobro" FontWeight="Bold" Foreground="#344054" FontSize="14" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Efectivo recibido ($)" Foreground="#344054" FontSize="12" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtEfectivo" Height="32" Padding="6,3" FontSize="15" VerticalContentAlignment="Center"
                                     TextChanged="TxtEfectivo_TextChanged" />
                            <Button Grid.Column="1" Content="Exacto" Margin="6,0,0,0" Padding="10,0" Background="#EEF2F6"
                                    BorderThickness="0" Click="BtnExacto_Click" />
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="$10" Padding="10,4" Margin="0,0,6,6" Background="#EEF2F6" BorderThickness="0" Tag="10" Click="BtnMontoRapido_Click" />
                            <Button Content="$20" Padding="10,4" Margin="0,0,6,6" Background="#EEF2F6" BorderThickness="0" Tag="20" Click="BtnMontoRapido_Click" />
                            <Button Content="$50" Padding="10,4" Margin="0,0,6,6" Background="#EEF2F6" BorderThickness="0" Tag="50" Click="BtnMontoRapido_Click" />
                            <Button Content="$100" Padding="10,4" Margin="0,0,6,6" Background="#EEF2F6" BorderThickness="0" Tag="100" Click="BtnMontoRapido_Click" />
                            <Button Content="$500" Padding="10,4" Background="#EEF2F6" BorderThickness="0" Tag="500" Click="BtnMontoRapido_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Tarjeta ($)" Foreground="#344054" FontSize="12" />
                        <TextBox x:Name="TxtTarjeta" Height="32" Padding="6,3" FontSize="15" VerticalContentAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="Transferencia / QR ($)" Foreground="#344054" FontSize="12" />
                        <TextBox x:Name="TxtQr" Height="32" Padding="6,3" FontSize="15" VerticalContentAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Vuelto" FontSize="16" Foreground="#344054" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="LblVuelto" FontSize="20" FontWeight="Bold" Foreground="#22A06B" Text="$0,00" />
                    </Grid>

                    <Button x:Name="BtnCobrar" Grid.Row="5" Content="COBRAR" Height="48" Margin="0,16,0,0"
                            Background="#22A06B" Foreground="White" BorderThickness="0" FontSize="16" FontWeight="Bold"
                            Click="BtnCobrar_Click" />

                    <TextBlock Grid.Row="6" x:Name="LblCajaAbierta" Foreground="#B54708" FontSize="12" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
